# Set these as Kubernetes Secret-backed environment variables in production.
# Use TLS in MySQL URLs and never commit populated values.
NEWS_DATABASE_URL=mysql+pymysql://finsights_news_app:replace-me@mysql-node-1:3306/finsights_news?charset=utf8mb4
MARKET_DATABASE_URL=mysql+pymysql://finsights_market_app:replace-me@mysql-node-1:3306/finsights_market?charset=utf8mb4
SCRAPING_DATABASE_URL=mysql+pymysql://finsights_scraping_app:replace-me@mysql-node-2:3306/finsights_scraping?charset=utf8mb4
MYSQL_NODE_1_TLS_CA_FILE=/var/run/secrets/mysql-node-1/ca.pem
MYSQL_NODE_2_TLS_CA_FILE=/var/run/secrets/mysql-node-2/ca.pem

# Vietstock licensed DataFeed only. The public live board does not support
# arbitrary historical date windows. Fill request/response mapping from the
# contract before enabling the EOD schedule.
VIETSTOCK_HISTORY_ENDPOINT=
VIETSTOCK_API_TOKEN=replace-me
VIETSTOCK_MAPPING_FILE=configs/sources/market/vietstock-datafeed-mapping.yaml

# OCI Object Storage S3-compatible configuration
OCI_TOKYO_S3_ENDPOINT_URL=https://nryqf437jjy5.compat.objectstorage.ap-tokyo-1.oraclecloud.com
OCI_TOKYO_S3_REGION=ap-tokyo-1
OCI_TOKYO_S3_BUCKET_NAME=finsights-data-assets-tokyo
OCI_TOKYO_S3_ACCESS_KEY_ID=replace-me
OCI_TOKYO_S3_SECRET_ACCESS_KEY=replace-me

OCI_SINGAPORE_S3_ENDPOINT_URL=https://axrxyxi3tkjc.compat.objectstorage.ap-singapore-1.oraclecloud.com
OCI_SINGAPORE_S3_REGION=ap-singapore-1
OCI_SINGAPORE_S3_BUCKET_NAME=finsights-data-assets-singapore
OCI_SINGAPORE_S3_ACCESS_KEY_ID=replace-me
OCI_SINGAPORE_S3_SECRET_ACCESS_KEY=replace-me

ENABLE_OCI_MEDIA_UPLOAD=true

# CafeF polite crawling controls.
CAFEF_REQUEST_RATE_PER_SECOND=0.5
CAFEF_MAX_PAGES_PER_CATEGORY=5000
